# Copy to .env.local and fill in. Never commit real keys.
META_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
# App URLs. Defaults shown.
# SALTBREAK_URL=http://localhost:3000
# ATLAS_URL=http://localhost:3001
# Optional: SQLite locations. Defaults to <repo>/data/saltbreak.db and <repo>/data/atlas.db
# SALTBREAK_DB_PATH=
# ATLAS_DB_PATH=
# Optional: worker port. Defaults to 3101
# WORKER_PORT=
# Optional: Playwright browser location. Defaults to the OS cache.
# Use a repo-local path if the default cache is unavailable.
# PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers
