# Copy to .env.local and fill in. Never commit .env.local.
# Real environment variables always win over this file.
TARGET_URL=http://localhost:3000
GHOST_PROVIDER=fixture
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3

# Phone notification when a "Run on many" batch finishes (https://ntfy.sh).
# Pick a hard-to-guess topic and subscribe to it in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# "While you were away" page. The phone must be on the same Wi-Fi.
# Host defaults to this machine's LAN address.
GHOST_AWAY_HOST=
GHOST_AWAY_PORT=3200
# Optional: keeps away-page links valid across app restarts.
GHOST_AWAY_SECRET=

# Spoken notes: any OpenAI-compatible /audio/transcriptions endpoint.
# Without a key, the mic returns a canned transcript (offline rehearsal).
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
